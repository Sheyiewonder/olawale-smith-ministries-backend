generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * --------------------------------------------------------------------------
 * Enums
 * --------------------------------------------------------------------------
 */

enum ResourceType {
  SERMON
  EBOOK
  SONG
  VIDEO
  PODCAST
  ARTICLE
}

enum MediaType {
  AUDIO
  PDF
  IMAGE
  VIDEO
}

enum MediaProvider {
  CLOUDINARY
  SUPABASE
  YOUTUBE
  EXTERNAL
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

/**
 * --------------------------------------------------------------------------
 * Resource
 * --------------------------------------------------------------------------
 */

model Resource {
  id String @id @default(cuid())

  title       String
  slug        String  @unique
  description String? @db.Text
  content     String? @db.Text

  type ResourceType

  speaker  String?
  duration Int?

  featured  Boolean @default(false)
  published Boolean @default(false)

  publishedAt DateTime?

  /**
   * Thumbnail
   * Points to a MediaAsset used as the resource's
   * primary thumbnail.
   */

  thumbnailId String?
  thumbnail   MediaAsset? @relation("ResourceThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)

  /**
   * Media
   */

  media MediaAsset[] @relation("ResourceMedia")

  /**
   * Series
   */

  seriesId String?
  series   Series? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  /**
   * Categories & Tags
   */

  categories ResourceCategory[]
  tags       ResourceTag[]

  /**
   * Timestamps
   */

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * Indexes
   */

  @@index([type])
  @@index([published])
  @@index([publishedAt])
  @@index([featured])
  @@index([seriesId])
}

/**
 * --------------------------------------------------------------------------
 * Media Asset
 * --------------------------------------------------------------------------
 */

model MediaAsset {
  id String @id @default(cuid())

  type     MediaType
  provider MediaProvider

  title String?

  /**
   * Public URL for the media.
   * Examples:
   * - Cloudinary delivery URL
   * - Supabase Storage public URL
   * - YouTube URL
   * - External media URL
   */

  url String?

  /**
   * Provider-specific storage identifier.
   * Cloudinary:
   * public_id
   * Supabase:
   * storage path
   * External providers:
   * optional provider-specific key
   */

  storageKey String?

  /**
   * Provider-specific external identifier.
   * YouTube:
   * video ID
   */

  externalId String?

  /**
   * MIME type of the media.
   */

  mimeType String?

  /**
   * Stored as String rather than BigInt so Prisma results
   * can be returned directly through Fastify/JSON without
   * BigInt serialization issues.
   * Example:
   * "52428800"
   */

  fileSize String?

  /**
   * Duration in seconds.
   * Used primarily for:
   * - sermons
   * - songs
   * - podcasts
   * - audio/video media
   */

  duration Int?

  /**
   * Thumbnail URL
   * Used for media-specific thumbnails.
   * For PDFs:
   * - Stores the Cloudinary-generated first-page thumbnail.
   * For audio:
   * - Stores the uploaded/custom audio artwork.
   * For other media:
   * - Can remain null when no media-specific thumbnail exists.
   */

  thumbnailUrl String?

  /**
   * Resource relationship
   */

  resourceId String?
  resource   Resource? @relation("ResourceMedia", fields: [resourceId], references: [id], onDelete: Cascade)

  /**
   * Resource thumbnail relationship
   * A MediaAsset can optionally be used as the primary
   * thumbnail of one or more resources.
   */

  thumbnailFor Resource[] @relation("ResourceThumbnail")

  /**
   * Timestamps
   */

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * Indexes
   */

  @@index([resourceId])
  @@index([provider])
  @@index([type])
}

/**
 * --------------------------------------------------------------------------
 * Category
 * --------------------------------------------------------------------------
 */

model Category {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String?

  resources ResourceCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * --------------------------------------------------------------------------
 * Tag
 * --------------------------------------------------------------------------
 */

model Tag {
  id String @id @default(cuid())

  name String
  slug String @unique

  resources ResourceTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * --------------------------------------------------------------------------
 * Series
 * --------------------------------------------------------------------------
 */

model Series {
  id String @id @default(cuid())

  title       String
  slug        String  @unique
  description String? @db.Text

  resources Resource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * --------------------------------------------------------------------------
 * Resource ↔ Category
 * --------------------------------------------------------------------------
 */

model ResourceCategory {
  resourceId String
  categoryId String

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([resourceId, categoryId])
  @@index([categoryId])
}

/**
 * --------------------------------------------------------------------------
 * Resource ↔ Tag
 * --------------------------------------------------------------------------
 */

model ResourceTag {
  resourceId String
  tagId      String

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
  @@index([tagId])
}

/**
 * --------------------------------------------------------------------------
 * Admin
 * --------------------------------------------------------------------------
 */

model Admin {
  id String @id @default(cuid())

  name     String
  email    String @unique
  password String

  role     AdminRole @default(ADMIN)
  isActive Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}
